# create a .env file in the root directory of the project and add your OpenAI API key to it. You can get your API key from https://platform.openai.com/account/api-keys

OPENAI_API_KEY= `paste your OpenAI API key here`

OPENAI_MODEL=gpt-4o-mini
CHROMA_DB_DIR=app/db

CHROMA_COLLECTION=rag_evidence
EMBEDDING_MODEL=text-embedding-3-small
